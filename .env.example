# Application
APP_ENV=local
LOG_LEVEL=info

# catalog-service
CATALOG_HTTP_ADDR=:8080
CATALOG_READ_TIMEOUT=5s
CATALOG_WRITE_TIMEOUT=10s
CATALOG_IDLE_TIMEOUT=60s
CATALOG_MAX_HEADER_BYTES=1048576
CATALOG_PRICING_GRPC_ADDR=localhost:9090
CATALOG_PRICING_GRPC_DEADLINE=2s

# pricing-service
PRICING_GRPC_ADDR=:9090
PRICING_DATABASE_URL=postgres://grpc_duo_app:grpc_duo_dev_password@localhost:5432/grpc_duo?sslmode=disable
PRICING_DATABASE_CONNECT_TIMEOUT=5s
PRICING_DATABASE_QUERY_TIMEOUT=2s
PRICING_DATABASE_MAX_OPEN_CONNS=5
PRICING_DATABASE_MAX_IDLE_CONNS=5
PRICING_DATABASE_CONN_MAX_LIFETIME=30m
PRICING_READINESS_CHECK_INTERVAL=10s

# PostgreSQL local development placeholders
POSTGRES_DB=grpc_duo
POSTGRES_USER=grpc_duo_app
POSTGRES_PASSWORD=grpc_duo_dev_password
